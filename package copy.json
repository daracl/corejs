  "scripts": {
    "build:dev": "webpack --config webpack.dev.js",
    "build:prod": "webpack --config webpack.prod.js",
    "test": "jest",
    "docs:gen": "typedoc --tsconfig tsconfig.doc.json",
    "start": "webpack-dev-server --open --config ./webpack.dev.server.js",
