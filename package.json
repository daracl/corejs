{
  "name": "@daracl/core",
  "version": "0.0.1",
  "sideEffects": false,
  "description": "daracl core library",
  "author": {
    "name": "darainfo",
    "email": "darainfosys@gmail.com",
    "url": "https://www.moaview.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daracl/corejs.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "keywords": [
    "@daracl/core",
    "daraclCore",
    "daracl-core",
    "darainfo",
    "javascript"
  ],
  "main": "src/index.ts",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "homepage": "https://github.com/daracl/corejs",
  "bugs": {
    "url": "https://github.com/daracl/corejs/issues",
    "email": "darainfosys@gmail.com"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./umd": {
      "import": "./dist/daracl.core.umd.js"
    },
    "./dist/": "./dist/",
    "./style/": "./style/"
  },
  "files": [
    "dist",
    "style"
  ],
  "scripts": {
    "prepack": "yarn build",
    "build": "vite build --mode production && vite build --mode development && yarn copy-dts && yarn build:tsc && yarn copy-unmin && yarn clean:unmin && yarn copy-html",
    "build:tsc": "tsc --emitDeclarationOnly",
    "dev": "vite",
    "preview": "vite preview",
    "docs:gen": "typedoc --tsconfig tsconfig.doc.json",
    "dts:gen": "tsc src/index.ts --declaration --emitDeclarationOnly --outDir dist",
    "test": "jest",
    "pwtest": "playwright test",
    "clean:unmin": "rimraf dist/unmin",
    "copy-html": "cpx \"public/index.html\" dist",
    "copy-unmin": "cpx \"dist/unmin/**.*\" dist",
    "copy-dts": "cpx \"src/**/*.d.ts\" dist",
    "api": "npx ts-node api/index.ts"
  },
  "dependencies": {
    "@daracl/loading": "^0.0.6",
    "express": "^4.18.2",
    "init": "^0.1.2",
    "ink-docstrap": "^1.3.2",
    "tslib": "^2.8.1",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0"
  },
  "prettier": {
    "printWidth": 256,
    "useTabs": false,
    "tabWidth": 2,
    "bracketSpacing": true,
    "semi": true,
    "singleQuote": false
  },
  "editor.formatOnSave": true,
  "[javascript]": {
    "editor.formatOnSave": false
  },
  "devDependencies": {
    "@babel/cli": "^7.22.5",
    "@babel/core": "^7.21.4",
    "@babel/node": "^7.20.7",
    "@babel/parser": "^7.21.4",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-export-default-from": "^7.25.9",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-arrow-functions": "^7.25.7",
    "@babel/plugin-transform-block-scoping": "^7.25.7",
    "@babel/plugin-transform-modules-commonjs": "^7.21.2",
    "@babel/plugin-transform-runtime": "^7.21.4",
    "@babel/plugin-transform-strict-mode": "^7.25.7",
    "@babel/preset-env": "^7.22.5",
    "@babel/preset-typescript": "^7.21.4",
    "@babel/runtime-corejs3": "^7.26.0",
    "@types/dropzone": "^5.7.4",
    "@types/express": "^4.17.17",
    "@types/file-saver": "^2.0.5",
    "@types/jest": "^29.5.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.1.0",
    "@types/sinon": "^17.0.3",
    "@typescript-eslint/eslint-plugin": "^5.59.5",
    "@typescript-eslint/parser": "^5.59.5",
    "cpx": "^1.5.0",
    "eslint": "^8.40.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "material-icons": "^1.13.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^2.8.8",
    "rimraf": "^6.0.1",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-visualizer": "^6.0.3",
    "sass": "^1.80.2",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.2",
    "typedoc": "^0.28.13",
    "typescript": "^5.1.6",
    "vite": "^5.4.0",
    "vite-plugin-banner": "^0.7.1"
  }
}
