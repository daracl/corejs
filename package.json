{
  "name": "@daracl/core",
  "version": "0.0.1",
  "sideEffects": [
    "src/index.umd.ts",
    "./style/*.scss"
  ],
  "description": "daracl core library",
  "author": {
    "name": "darainfo",
    "email": "darainfosys@gmail.com",
    "url": "https://www.moaview.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daracl/corejs.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "keywords": [
    "@daracl/core",
    "daraclCore",
    "daracl-core",
    "darainfo",
    "javascript"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "homepage": "https://github.com/daracl/corejs",
  "bugs": {
    "url": "https://github.com/daracl/corejs/issues",
    "email": "darainfosys@gmail.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./umd": {
      "import": "./dist/daracl.core.umd.js"
    },
    "./dist/": "./dist/",
    "./style/": "./style/"
  },
  "files": [
    "dist",
    "style"
  ],
  "scripts": {
    "prepack": "yarn build",
    "build": "yarn build:escjs && yarn build:umd && yarn mergenclean",
    "build:umd": "vite build --config vite.config.umd.js --mode production && vite build --config vite.config.umd.js --mode development",
    "build:escjs": "vite build --config vite.config.js --mode production && vite build --config vite.config.js --mode development",
    "mergenclean": "yarn copy-dts && yarn build:tsc && yarn copy-unmin && yarn clean:unmin && yarn copy-html",
    "build:tsc": "tsc --emitDeclarationOnly",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:server\"",
    "dev:vite": "vite",
    "dev:server": "npx ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" api/index.ts",
    "preview": "vite preview",
    "docs:gen": "typedoc --tsconfig tsconfig.doc.json",
    "dts:gen": "tsc src/index.ts --declaration --emitDeclarationOnly --outDir dist",
    "test": "jest",
    "pwtest": "playwright test",
    "clean:unmin": "rimraf dist/unmin",
    "copy-html": "cpx \"public/index.html\" dist",
    "copy-unmin": "cpx \"dist/unmin/**.*\" dist",
    "copy-dts": "cpx \"src/**/*.d.ts\" dist"
  },
  "dependencies": {
    "express": "^4.22.1",
    "init": "^0.1.2",
    "ink-docstrap": "^1.3.2",
    "tslib": "^2.8.1",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0"
  },
  "prettier": {
    "printWidth": 256,
    "useTabs": false,
    "tabWidth": 2,
    "bracketSpacing": true,
    "semi": true,
    "singleQuote": false
  },
  "editor.formatOnSave": true,
  "[javascript]": {
    "editor.formatOnSave": false
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/file-saver": "^2.0.5",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.1.0",
    "@types/sinon": "^17.0.3",
    "@typescript-eslint/eslint-plugin": "^5.59.5",
    "@typescript-eslint/parser": "^5.59.5",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "cpx": "^1.5.0",
    "eslint": "^8.40.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "material-icons": "^1.13.8",
    "multer": "^2.0.2",
    "prettier": "^2.8.8",
    "rimraf": "^6.0.1",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-visualizer": "^6.0.3",
    "sass": "^1.80.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.4.2",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.13",
    "typescript": "^5.1.6",
    "vite": "^5.4.0",
    "vite-plugin-banner": "^0.7.1"
  }
}
