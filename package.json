{
  "name": "@daracl/core",
  "version": "0.0.12",
  "sideEffects": [
    "src/index.umd.ts",
    "./style/*.scss",
    "./style/*.css",
    "./dist/*.umd.js",
    "./dist/*.css"
  ],
  "description": "daracl core library",
  "author": {
    "name": "darainfo",
    "email": "darainfosys@gmail.com",
    "url": "https://www.moaview.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daracl/corejs.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "keywords": [
    "@daracl/core",
    "daraclCore",
    "daracl-core",
    "darainfo",
    "javascript"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "homepage": "https://github.com/daracl/corejs",
  "bugs": {
    "url": "https://github.com/daracl/corejs/issues",
    "email": "darainfosys@gmail.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./umd": {
      "import": "./dist/daracl.core.umd.js"
    },
    "./utils": {
      "daracl-source": "./src/utils/index.ts",
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./style/*": "./style/*"
  },
  "files": [
    "dist",
    "style"
  ],
  "typesVersions": {
    "*": {
      "utils": [
        "dist/utils/index.d.ts"
      ]
    }
  },
  "scripts": {
    "prepack": "npm run build",
    "prepublishOnly": "npm run test:all",
    "build": "node scripts/build.mjs",
    "build:umd": "vite build --config vite.config.umd.mjs --mode production && vite build --config vite.config.umd.mjs --mode development",
    "build:escjs": "vite build --config vite.config.mjs --mode production && vite build --config vite.config.mjs --mode development",
    "mergenclean": "npm run copy-dts && npm run build:tsc && npm run copy-unmin && npm run clean:unmin && npm run copy-html",
    "build:tsc": "tsc --project tsconfig-build.json --emitDeclarationOnly",
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:server\"",
    "dev:vite": "vite",
    "dev:server": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" api/index.ts",
    "preview": "vite preview",
    "docs:gen": "typedoc --tsconfig tsconfig.doc.json",
    "dts:gen": "npm run build:tsc",
    "test": "jest",
    "test:ajax": "jest test/ajax/index.test.ts",
    "test:all": "jest --testPathIgnorePatterns=test/ajax/ajax-.*.test.ts",
    "pwtest": "playwright test",
    "clean:unmin": "node scripts/build-files.mjs clean-unmin",
    "copy-html": "node scripts/build-files.mjs html",
    "copy-unmin": "node scripts/build-files.mjs unmin",
    "copy-dts": "node scripts/build-files.mjs dts",
    "verify": "node scripts/harness.mjs verify",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "audit:security": "npm audit --omit=dev",
    "audit:security:all": "npm audit"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "prettier": {
    "printWidth": 256,
    "useTabs": false,
    "tabWidth": 2,
    "bracketSpacing": true,
    "semi": true,
    "singleQuote": false
  },
  "editor.formatOnSave": true,
  "[javascript]": {
    "editor.formatOnSave": false
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.1.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-html-reporter": "^4.4.2",
    "multer": "^2.5.0",
    "prettier": "^2.8.8",
    "sass": "^1.106.1",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.20",
    "typescript": "~5.9.3",
    "vite": "~7.3.7",
    "express": "^4.22.3",
    "rollup": "^4.65.1"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "npm@12.2.1"
}
