{
  "name": "@daracl/core",
  "version": "0.0.1",
  "sideEffects": false,
  "description": "Daracl form validation ",
  "author": {
    "name": "darainfo",
    "email": "darainfosys@gmail.com",
    "url": "https://www.moaview.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/darainfo/daracl.core.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "keywords": [
    "@daracl/core",
    "daraclCore",
    "daracl-core",
    "darainfo",
    "javascript"
  ],
  "main": "src/index.ts",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/darainfo/daracl.core",
  "bugs": {
    "url": "https://github.com/darainfo/daracl.core/issues",
    "email": "darainfosys@gmail.com"
  },
  "exports": {
    ".": "./dist/index.js",
    "./dist/": "./dist/",
    "./style/": "./style/"
  },
  "files": [
    "dist",
    "style"
  ],
  "scripts": {
    "prepack": "yarn build",
    "build": "yarn build:prod  && yarn copy-dts && yarn build:tsc && yarn build:js",
    "build:tsc": "npx tsc --emitDeclarationOnly",
    "build:js": "node build.js",
    "build:vender": "webpack --config webpack.vender.js",
    "build:dev": "webpack --config webpack.dev.js",
    "build:prod": "webpack --config webpack.prod.js && webpack --env=mode=deploy --config webpack.dev.js",
    "dts:gen": "npx -p typescript tsc src/index.js --declaration --allowJs --emitDeclarationOnly --outDir dist",
    "docs:gen": "typedoc --tsconfig tsconfig.doc.json",
    "test": "jest",
    "start": "webpack-dev-server --config ./webpack.dev.server.js",
    "copy-dts": "copyfiles -u 1 \"src/**/*.d.ts\" dist",
    "api": "npx ts-node api/index.ts"
  },
  "dependencies": {
    "@daracl/loading": "^0.0.2",
    "express": "^4.18.2",
    "init": "^0.1.2",
    "ink-docstrap": "^1.3.2",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0"
  },
  "prettier": {
    "printWidth": 256,
    "useTabs": false,
    "tabWidth": 2,
    "bracketSpacing": true,
    "semi": true,
    "singleQuote": false
  },
  "editor.formatOnSave": true,
  "[javascript]": {
    "editor.formatOnSave": false
  },
  "devDependencies": {
    "@babel/cli": "^7.22.5",
    "@babel/core": "^7.21.4",
    "@babel/node": "^7.20.7",
    "@babel/parser": "^7.21.4",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-export-default-from": "^7.25.9",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-arrow-functions": "^7.25.7",
    "@babel/plugin-transform-block-scoping": "^7.25.7",
    "@babel/plugin-transform-modules-commonjs": "^7.21.2",
    "@babel/plugin-transform-runtime": "^7.21.4",
    "@babel/plugin-transform-strict-mode": "^7.25.7",
    "@babel/preset-env": "^7.22.5",
    "@babel/preset-typescript": "^7.21.4",
    "@babel/runtime-corejs3": "^7.26.0",
    "@mxssfd/typedoc-theme": "^1.1.1",
    "@types/dropzone": "^5.7.4",
    "@types/express": "^4.17.17",
    "@types/file-saver": "^2.0.5",
    "@types/jest": "^29.5.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.1.0",
    "@types/sinon": "^17.0.3",
    "@typescript-eslint/eslint-plugin": "^5.59.5",
    "@typescript-eslint/parser": "^5.59.5",
    "babel-jest": "^29.7.0",
    "babel-loader": "^8.3.0",
    "babel-plugin-dynamic-import-webpack": "^1.1.0",
    "babel-preset-env": "^1.7.0",
    "copy-webpack-plugin": "^11.0.0",
    "copyfiles": "^2.4.1",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "esbuild": "^0.19.2",
    "esbuild-loader": "^4.2.2",
    "esbuild-sass-plugin": "^2.12.0",
    "eslint": "^8.40.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "material-icons": "^1.13.8",
    "mini-css-extract-plugin": "^2.7.6",
    "multer": "^1.4.5-lts.1",
    "prettier": "^2.8.8",
    "sass": "^1.80.2",
    "sass-loader": "^16.0.2",
    "sinon": "^19.0.2",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.9",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.2",
    "typedoc": "^0.26.7",
    "typescript": "^5.1.6",
    "url-loader": "^4.1.1",
    "webpack": "^5.73.0",
    "webpack-bundle-analyzer": "^4.9.0",
    "webpack-cli": "^4.10.0",
    "webpack-dev-server": "^4.9.2",
    "webpack-node-externals": "^3.0.0",
    "xhr2": "^0.2.1"
  }
}
